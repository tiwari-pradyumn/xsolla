# Bearer token for all /v1 routes. This is the token handed over at submission.
# Required: the service refuses to start without it.
AUTH_TOKEN=change-me

# Credentials for the `llm` provider. They live only on this server; callers
# never send a model key. Without GEMINI_API_KEY the llm provider fails jobs
# cleanly with a `failed` status rather than crashing.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=20

# Port to listen on (defaults to 8000).
PORT=8000
